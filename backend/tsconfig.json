{
    "compilerOptions": {
        "target": "es2017",
        "module": "commonjs",
        "lib": [
            "es6",
            "esnext"
        ],
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist"
    },
    "include": [
        "prisma/**/*",
        "*.ts",
        "*.js"
    ],
    "exclude": [
        "node_modules"
    ]
}